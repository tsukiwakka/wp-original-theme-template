{
  "name": "wp-theme-template",
  "version": "1.0.0",
  "description": "WordPress original theme with Vite + Tailwind CSS + SCSS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:bs": "node bs-watch.mjs",
    "dev": "concurrently --names \"VITE,BS\" --prefix-colors \"cyan,magenta\" \"npm run dev:vite\" \"npm run dev:bs\"",
    "build": "vite build",
    "lint:js": "eslint 'theme/src/js/**/*.js'",
    "lint:css": "stylelint 'theme/src/scss/**/*.scss'"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.3",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "sass": "^1.86.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0",
    "chokidar": "^4.0.0",
    "ws": "^8.18.0"
  }
}
